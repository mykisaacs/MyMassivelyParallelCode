      "cell_type": "markdown",
      "source": [
        "### 1. Verify nvcc CUDA Installation\n",
        "\n",
        "First let's check if `nvcc` the CUDA Compiler is available and see it's version. It's usually in Colab pre-installed."
      ],
      "metadata": {
        "id": "iWEtAkMhg2XT"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import subprocess\n",
        "\n",
        "try:\n",
        "  # Check nvcc version\n",
        "  result = subprocess.run(['nvcc', '--version'], capture_output=True, text=True, check=True)\n",
        "  print(result.stdout)\n",
        "except FileNotFoundError:\n",
        "  print(\"nvcc not found. CUDA Toolkit might not be installed or not in PATH.\")\n",
        "except subprocess.CalledProcessError as e:\n",
        "  print(f\"Error checking nvcc version: {e}\\n{e.stderr}\")"
      ],
      "metadata": {
        "id": "CxtIiRXThDQS"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "### 2. Create a CUDA C / C++ Source File (.cu)\n",
        "\n",
        "We'll create a simple CUDA C program named matrix_mul.cu to show matrix multipication kernel functionality."
      ],
      "metadata": {
        "id": "BF3a57G7ivfG"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "%%writefile matrix_mul.cu -o matrix_mul\n",
        "\n",
        "#include <stdio.h>\n",
        "#include <stdlib.h>\n",
        "#include <cuda_runtime.h>\n",
        "\n",
        "__global__ void MatrixMulKernel(float* M, float* N, float* P, int width) {\n",
        "  int row = blockIdx.y*blockDim.y + threadIdx.y ;\n",
        "  int col = blockIdx.x*blockDim.x + threadIdx.x ;\n",
        "  if ((row < Width) && (col < Width)) { // simple case where both sides == Width\n",
        "    float Pvalue = 0;\n",
        "    for (int k = 0; k<Width;++k) {\n",
        "      Pvalue += M[row*Width+k]*N[k*Width+col];\n",
        "    }\n",
        "    P[row*Width+col] = Pvalue ;\n",
        "  }\n",
        "}\n",
        "\n",
        "\n",
        "__global__ void MatrixMulKernel_ex1A_rowOutput(float* M, float* N, float* P, int width, int height) {\n",
        "  int row = blockIdx.y*blockDim.y + threadIdx.y ; // thread row position,\n",
        "  // int col = blockIdx.x*blockDim.x + threadIdx.x ; // 1-D so thread col does not matter\n",
        "\n",
        "  if ((row < height)) {\n",
        "    float Pvalue = 0 ;\n",
        "    for (int j = 0; j < width; ++j) { // for each outer column position of matrix N\n",
        "      for (int k = 0; k < height; ++k) { // for reach row position in col\n",
        "        Pvalue += M[j] * N[k*height + j]\n",
        "      }\n",
        "      P[row*height+j] = Pvalue; // place each value onto corresponding col position in row\n",
        "    }\n",
        "  }\n",
        "}\n",
        "\n",
        "MatrixMulKernel_ex1A_rowOutput<<< 1, dimBlock(n,1,1) >>>(M_d, N_d, P_d, n, n) ; // M 1*k row vector,   N is k*n matrix => P is 1 * n row vector\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "__global__ void MatrixMulKernel_ex1B_colOutput(float* M, float* N, float* P, int width, int height) {\n",
        "  //int row = blockIdx.y*blockDim.y + threadIdx.y ; // 1-D so thread row does not matter\n",
        "  int col = blockIdx.x*blockDim.x + threadIdx.x ;\n",
        "\n",
        "  if (col < width) {\n",
        "    float Pvalue = 0 ;\n",
        "    for (int j = 0; j < height; ++j) { // for each outer column position of matrix N\n",
        "      for (int k = 0; k < width; ++k) { // for reach row position in col\n",
        "        Pvalue += M[j] * N[k*width + j]\n",
        "      }\n",
        "      P[col*width+k] = Pvalue; // place each value onto corresponding col position in row\n",
        "    }\n",
        "  }\n",
        "}\n",
        "\n",
        "MatrixMulKernel_ex1B_colOutput<<< 1, dimBlock(1,n,1) >>>(M_d, N_d, P_d, n, n) ; // M 1*k row vector,   N is k*n matrix => P is 1 * n row vector\n",
        "\n",
        "\n",
        "// Pros: fewer threads needed per block\n",
        "// Cons: more calc for the threads in the loops\n",
        "\n",
        "\n",
        "\n"
      ],
      "metadata": {
        "id": "LXvNMPvrrp5t"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "### 3. Compile the CUDA Code using `nvcc`\n",
        "\n",
        "Now we'll use the `nvcc` compiler to compile our `matrix_mul.cu` file into an executable. We'll name the output executable `matrix_mul`."
      ],
      "metadata": {
        "id": "GyEurAdkjwd-"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "!nvcc matrix_mul.cu -o matrix_mul"
      ],
